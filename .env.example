# CLASSIFIED configuration. Copy to .env.local and adjust.
# All values are public (they ship to the browser) — never put secrets here.

# "test" (default) or "main". The game is designed and labelled for TESTNET.
VITE_ZCASH_NETWORK=test

# gRPC-web proxied lightwalletd. Plain lightwalletd URLs do NOT work in browsers.
VITE_LIGHTWALLETD_URL=https://zcash-testnet.chainsafe.dev

# Testnet faucet the player is sent to in Mission 02.
VITE_FAUCET_URL=https://faucet.testnet.valargroup.dev

# Block explorer used for "view on chain" links ({txid} / {address} are substituted).
VITE_EXPLORER_TX_URL=https://testnet.zcashexplorer.app/transactions/{txid}
VITE_EXPLORER_ADDRESS_URL=https://testnet.zcashexplorer.app/address/{address}

# Confirmations required before funds count as spendable / a tx counts as delivered.
VITE_MIN_CONFIRMATIONS=1

# Optional fixed recipient for Mission 05. If empty, the contact is a second
# account derived in the player's own browser wallet so the receive side is visible.
VITE_CONTACT_ADDRESS=
