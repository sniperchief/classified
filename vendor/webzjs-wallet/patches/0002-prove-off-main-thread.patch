+        let inner = self.inner.clone();
+        let pczt: pczt::Pczt = pczt.into();
+        let key = sapling_proof_gen_key.map(Into::into);
+        let handle = thread::Builder::new()
+            .name("prove".to_string())
+            .spawn_async(move || async move {
+                inner
+                    .pczt_prove(pczt, key)
+                    .await
+                    .map_err(|e| e.to_string())
+            })
+            .unwrap_throw()
+            .join_async();
+        match handle.await {
+            Ok(Ok(pczt)) => Ok(pczt.into()),
+            Ok(Err(msg)) => Err(Error::PcztProve(msg)),
+            Err(panic) => Err(Error::PcztProve(format!("Prove thread panicked: {:?}", panic))),
+        }
     }
 
