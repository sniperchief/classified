+    /// CLASSIFIED patch: proof generation key for the account's *internal* Sapling key
+    /// (ZIP 32 `derive_internal`). Shielding (`propose_shielding`) sends funds to the internal
+    /// address, so spending those notes needs this key rather than the external one.
+    pub fn to_sapling_internal_proof_generation_key(&self) -> ProofGenerationKey {
+        ProofGenerationKey {
+            inner: self.inner.sapling().derive_internal().expsk.proof_generation_key(),
+        }
+    }
 }
 
